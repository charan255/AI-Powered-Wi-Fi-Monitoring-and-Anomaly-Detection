# ==============================================================================
# AI-Powered Wi-Fi Network Monitoring & Anomaly Detection System
# Backend Configuration
# ==============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Connects to local MongoDB instance or MongoDB Atlas URI (mongodb+srv://...)
MONGO_URI=mongodb://localhost:27017
DB_NAME=wifi_monitor_db

# Packet Sniffer Configuration
# Empty string auto-detects default Wi-Fi/Ethernet interface with Scapy
CAPTURE_INTERFACE=
# Set to 'false' for live Scapy/Npcap packet sniffing, 'true' for simulation/demo
SIMULATION_MODE=true

# Detection Thresholds
WINDOW_SECONDS=5
PORT_SCAN_PORT_THRESHOLD=15
PORT_SCAN_TIME_WINDOW=5
PACKET_SPIKE_FACTOR=3.5
BANDWIDTH_BURST_THRESHOLD_BYTES=5000000

# Machine Learning Settings
ML_CONTAMINATION=0.05
ML_MODEL_PATH=isolation_forest.joblib
RETRAIN_INTERVAL_MINUTES=60
